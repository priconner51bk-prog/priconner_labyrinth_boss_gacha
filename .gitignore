# Python / local development
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
build/
*.egg-info/
.venv/
venv/
env/
.env
.local_gui_settings.json
.local_adb_runtime.json
.env.*
!.env.example

# Local editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime output: may contain screenshots, OCR text, device information,
# coordinates, and other environment-specific data. Keep the rule scoped to
# the runtime observation directory so committed fixtures remain visible.
data/observations/
**/data/observations/
# Runtime evidence stays local; only explicitly force-added template_*.png files
# are eligible for publication.
data/**/*.jsonl
data/**/*.log

# Generated local reports and temporary investigation files.
artifacts/
reports/
distribution/_staging_*/
# Old expanded distribution copies are local staging material. The ZIP builder
# reads reviewed files from the repository root instead.
/distribution/configs/
/distribution/data/
/distribution/docs/
/distribution/scripts/
/distribution/src/
/distribution/main.py
/distribution/requirements.txt
/distribution/SECURITY.md
cloud_status.json
_tmp_*.py

# Windows reserved-name artifact occasionally created by interrupted tooling.
CON

# OCR/model artifacts: keep models outside the repository.
*.onnx
*.pdparams
*.pdmodel
*.bin
models/
model/

# Local-only configuration and exports
config.local.*
configs/local/
secrets/

# Distribution boundary: local-only runtime data is never published.
local/*
!local/README.md
